{
  "manifest_version": 2,
  "name": "Gelbooru Formatted Filename Downloader",
  "version": "1.6",
  "description": "Download images from Gelbooru with descriptive filenames.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "permissions": [
    "downloads",
    "*://*.gelbooru.com/*",
    "webRequest",
    "webRequestBlocking"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png"
    },
    "default_title": "Gelbooru Formatted Filename Downloader"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.gelbooru.com/index.php?page=post&s=view&id=*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ophiuchusye@gmail.com"
    }
  }
}